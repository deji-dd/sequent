# Sequent environment template. Copy to .env or .env.development and fill in values.
PORT=3003

# PostgreSQL (optional; without it Sequent runs with in-memory persistence)
POSTGRES_HOST=/var/run/postgresql
POSTGRES_PORT=5432
POSTGRES_DB=sequent_db
POSTGRES_USER=sequent_user
POSTGRES_PASSWORD=replace-me

# Alternatively provide a full connection URL (takes precedence over POSTGRES_*):
# DATABASE_URL=postgres://sequent_user:replace-me@127.0.0.1:5432/sequent_db

# Comma-separated list of allowed CORS origins. Leave unset for development-style permissive CORS.
# CORS_ORIGIN=https://sequent.example.com

# How long terminal executions stay inspectable in memory before being pruned.
EXECUTION_RETENTION_MS=60000

# Maximum number of in-memory execution records tracked at once.
MAX_TRACKED_EXECUTIONS=200
