{
  "name": "sequent",
  "version": "1.0.0",
  "description": "Event-sourced distributed workflow engine and visual execution debugger with deterministic replay, worker fencing, and saga compensation",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=.env.development --watch src/index.ts",
    "dev:ui": "NODE_ENV=development vite",
    "build": "NODE_ENV=production vite build",
    "start": "NODE_ENV=production bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "sync:env": "bash scripts/sync-env.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@dagrejs/dagre": "latest",
    "@elysiajs/cors": "latest",
    "@elysiajs/static": "latest",
    "@fontsource-variable/geist": "latest",
    "@types/dagre": "latest",
    "@xyflow/react": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "latest",
    "elysia": "latest",
    "lucide-react": "latest",
    "postgres": "latest",
    "radix-ui": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "shadcn": "latest",
    "tailwind-merge": "latest",
    "tw-animate-css": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
